{
  "name": "herdr-recover",
  "displayName": "Herdr Recover",
  "description": "Remembers each Claude Code session on its Herdr terminal, so herdr-core can resume it after a restart or a reboot (with the shell install.sh sets up).",
  "author": { "name": "guillaume86", "url": "https://github.com/guillaume86" },
  "homepage": "https://github.com/guillaume86/herdr-recover",
  "repository": "https://github.com/guillaume86/herdr-recover",
  "license": "MIT",
  "keywords": ["herdr", "resume", "restart", "terminal"],
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook/recover-hook.sh\" claude", "async": true, "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook/recover-hook.sh\" claude", "timeout": 10 }] }
    ]
  }
}
